# 依赖
node_modules/
.pnp
.pnp.js

# 构建产物
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# PWA：Service Worker 是 @serwist/next 在构建时从 src/sw.ts 生成的，不进版本库
# （public/ 下唯一由构建生成的文件；图标是 scripts/generate-icons.mjs 的产物，那个要提交）
/public/sw.js
/public/sw.js.map

# 环境变量（会话密钥、单用户 token、VAPID 密钥等）
.env
.env*.local

# 运行时数据：容器挂 ./data，数据库与备份都在这里
/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# 导出与备份
*.bak
fitness-export.json
fitness-sessions.csv

# 测试产物
coverage/

# 日志
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python 缓存
__pycache__/
*.pyc

# 编辑器 / 操作系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 本机工具配置：含本机绝对路径与命名管道，不应该进版本库
.zcode/

