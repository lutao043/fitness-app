# 环境变量示例（复制为 .env 后填真实值；.env 不进版本库）
# 全部时间按 Asia/Shanghai（NFR-7 / 需求书第 9 章第 4 条）
TZ=Asia/Shanghai

# 数据目录（容器里挂 ./data；本机开发默认 ./data）
DATA_DIR=./data

# session cookie 签名密钥（jose 签发，D2）。生成：openssl rand -base64 32
SESSION_SECRET=

# 助手调 /api/v1/* 用的 Bearer token（需求书第 7 章）。留空则每个请求都要 session 登录
API_TOKEN=

# 单用户登录名（密码在首次启动的「设置密码」页里设，argon2 哈希入库）
APP_USERNAME=me

# 端口（默认 3210）
PORT=3210
