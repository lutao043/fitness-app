# 包管理源（国内镜像；只在开发机生效，容器构建里用默认源或同样覆盖）
registry=https://registry.npmmirror.com
# better-sqlite3 的预编译二进制也从镜像取（prebuild-install 会读这个 npm 配置）
better_sqlite3_binary_host=https://registry.npmmirror.com/-/binary/better-sqlite3/
# 让 pnpm 的新版本提示安静一点
update-notifier=false
# Windows 开发机：Next 的 standalone 产物会复制/重建符号链接，未开启「开发者模式」会 EPERM。
# hoisted 布局不用符号链接，本地与容器都稳（Docker 里同样可用，只是 node_modules 大一点）。
node-linker=hoisted
